# Database Configuration
R2DBC_HOST=localhost
R2DBC_PORT=5433
R2DBC_DATABASE=crediya_authentication_db
R2DBC_SCHEMA=public
R2DBC_USERNAME=postgres
R2DBC_PASSWORD=nueva_contraseña

# JWT Configuration
JWT_SECRET=mySecretKeyForCrediyaAuthenticationServiceThatIsLongEnoughForHS256
JWT_EXPIRATION=86400000

# Spring Profile
SPRING_PROFILES_ACTIVE=local

# Docker/Podman Configuration
COMPOSE_PROJECT_NAME=crediya-auth
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081